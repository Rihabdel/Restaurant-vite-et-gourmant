<Files "index.html">
    SetHandler default-handler
</Files>

<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteBase /

    # Ne pas réécrire les fichiers existants
    RewriteCond %{REQUEST_FILENAME} -f
    RewriteRule ^ - [L]

    # API → index.php
    RewriteRule ^api(/.*)?$ /index.php [QSA,L]

    # Racine → index.html
    RewriteRule ^$ /index.html [L]

    # Tout le reste → index.html
    RewriteRule ^(.*)$ /index.html [L]
</IfModule>